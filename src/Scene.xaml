<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Scene" Width="1920" Height="1080" Background="#07080B" ClipToBounds="True">
  <Canvas x:Name="Atmosphere" Width="1920" Height="1080" Opacity="0">
    <Rectangle Width="1920" Height="1080">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
          <GradientStop Color="#07080B" Offset="0"/>
          <GradientStop Color="#2A080F" Offset="0.52"/>
          <GradientStop Color="#A41B25" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Ellipse Canvas.Left="760" Canvas.Top="-430" Width="1500" Height="1500">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#A0F33D26" Offset="0"/>
          <GradientStop Color="#00F33D26" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Path Data="M860,-100 L1310,-100 630,1180 180,1180 Z" Fill="#18F74339"/>
    <Path Data="M1270,-100 L1290,-100 610,1180 590,1180 Z" Fill="#4BE14840"/>
    <TextBlock x:Name="BackNumber" Canvas.Left="1050" Canvas.Top="-100" Text="02" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="1050" Foreground="#22FF5243"/>
    <Path Data="M105,65 H1815 M105,1015 H1815" Stroke="#35E8D8D1" StrokeThickness="1"/>
  </Canvas>

  <Canvas x:Name="Intro" Width="1920" Height="1080" Opacity="0">
    <Viewbox Canvas.Left="894" Canvas.Top="417" Width="132" Height="132">
      <Path x:Name="IntroKnot" Fill="#F5F3EF" Stretch="Uniform"/>
    </Viewbox>
    <TextBlock Canvas.Left="0" Canvas.Top="600" Width="1920" TextAlignment="Center" Text="I N I T I A L I Z I N G   /   C O D E X" FontFamily="Bahnschrift" FontSize="18" Foreground="#BFBAB5"/>
    <Rectangle Canvas.Left="864" Canvas.Top="650" Width="192" Height="1" Fill="#4FFF4B3B"/>
  </Canvas>

  <Canvas x:Name="TitleCard" Width="1920" Height="1080" Opacity="0">
    <Rectangle Width="1920" Height="1080" Fill="#EC332B"/>
    <TextBlock Canvas.Left="95" Canvas.Top="70" Text="ASUKA" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="420" Foreground="#0B0A0D"/>
    <TextBlock Canvas.Left="1160" Canvas.Top="490" Text="02" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="470" Foreground="#0B0A0D"/>
    <TextBlock Canvas.Left="118" Canvas.Top="940" Text="SHIKINAMI LANGLEY     /     SECOND CHILD" FontFamily="Bahnschrift" FontSize="25" Foreground="#0B0A0D"/>
    <Path Data="M120,580 H1760" Stroke="#0B0A0D" StrokeThickness="6"/>
  </Canvas>

  <Canvas x:Name="Character" Width="1920" Height="1080" Opacity="0" RenderTransformOrigin="0.71,0.37">
    <Canvas.RenderTransform>
      <TransformGroup>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
        <TranslateTransform/>
      </TransformGroup>
    </Canvas.RenderTransform>
    <Canvas x:Name="ColorFill" Width="1920" Height="1080">
    <Canvas.OpacityMask>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.14,0">
        <LinearGradientBrush.RelativeTransform><TranslateTransform X="1.12"/></LinearGradientBrush.RelativeTransform>
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Canvas.OpacityMask>
    <Canvas x:Name="PortraitLayers" Width="940" Height="1410" Canvas.Left="890" Canvas.Top="24">
      <Canvas.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00FFFFFF" Offset="0"/>
          <GradientStop Color="#FFFFFFFF" Offset="0.075"/>
          <GradientStop Color="#FFFFFFFF" Offset="0.94"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Canvas.OpacityMask>
      <Image x:Name="HeroImage" Width="940" Height="1410" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Image x:Name="ClosedEyes" Width="940" Height="1410" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Image x:Name="HalfEyes" Width="940" Height="1410" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Canvas>
    </Canvas>
    <Image x:Name="LineImage" Canvas.Left="890" Canvas.Top="24" Width="940" Height="1410" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0">
      <Image.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,180" MappingMode="Absolute">
          <LinearGradientBrush.Transform><TranslateTransform Y="-240"/></LinearGradientBrush.Transform>
          <GradientStop Color="#FFFFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Image.OpacityMask>
      <Image.Effect><DropShadowEffect Color="#FF4732" ShadowDepth="0" BlurRadius="9" Opacity="0.8"/></Image.Effect>
    </Image>
  </Canvas>

  <Rectangle x:Name="LeftShade" Width="1280" Height="1080" Opacity="0">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F507080B" Offset="0"/>
        <GradientStop Color="#D907080B" Offset="0.5"/>
        <GradientStop Color="#0007080B" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>

  <Canvas x:Name="HeroType" Width="1920" Height="1080" Opacity="0">
    <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
    <Rectangle Canvas.Left="126" Canvas.Top="303" Width="55" Height="4" Fill="#FF4F3E"/>
    <TextBlock x:Name="PilotName" Canvas.Left="200" Canvas.Top="291" Text="S H I K I N A M I   L A N G L E Y" FontFamily="Bahnschrift" FontSize="18" Foreground="#F06C5D"/>
    <TextBlock x:Name="AsukaTitle" Canvas.Left="112" Canvas.Top="318" Text="ASUKA" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="203" Foreground="#F8F2E9"/>
    <TextBlock x:Name="JapaneseName" Canvas.Left="127" Canvas.Top="552" Text="式 波 ・ ア ス カ ・ ラ ン グ レ ー" FontFamily="Yu Gothic" FontSize="22" Foreground="#B9ACA8"/>
    <TextBlock x:Name="SecondChild" Canvas.Left="128" Canvas.Top="643" Text="SECOND CHILD" FontFamily="Bahnschrift" FontSize="18" Foreground="#F64E3D"/>
    <TextBlock x:Name="UnitLabel" Canvas.Left="128" Canvas.Top="678" Text="EVANGELION  /  UNIT 02" FontFamily="Bahnschrift" FontSize="16" Foreground="#8E8587"/>
  </Canvas>

  <Canvas x:Name="Sweep" Width="1920" Height="1080" Opacity="0">
    <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
    <Path Data="M980,-160 L1070,-160 440,1240 350,1240 Z">
      <Path.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00FF5946" Offset="0"/>
          <GradientStop Color="#70FF5946" Offset="0.6"/>
          <GradientStop Color="#FFFFC29E" Offset="0.96"/>
          <GradientStop Color="#00FF5946" Offset="1"/>
        </LinearGradientBrush>
      </Path.Fill>
    </Path>
  </Canvas>

  <Canvas x:Name="Details" Width="1920" Height="1080" Opacity="0">
    <TextBlock Canvas.Left="126" Canvas.Top="90" Text="C O D E X    /    P E R S O N A L   L A U N C H   S E Q U E N C E" FontFamily="Bahnschrift" FontSize="13" Foreground="#A19493"/>
    <TextBlock Canvas.Left="700" Canvas.Top="88" Text="PILOT : 02" FontFamily="Bahnschrift" FontSize="16" Foreground="#E6CCC3"/>
    <Path Data="M1810,610 V880 M1799,610 H1821 M1804,650 H1816 M1804,690 H1816 M1799,730 H1821 M1804,770 H1816 M1804,810 H1816 M1799,850 H1821" Stroke="#7AC6A29A" StrokeThickness="1"/>
    <Rectangle Canvas.Left="126" Canvas.Top="944" Height="2" Width="1668" Fill="#30B09892"/>
    <Rectangle x:Name="Progress" Canvas.Left="126" Canvas.Top="944" Height="2" Width="1668" Fill="#FF6350">
      <Rectangle.RenderTransform><ScaleTransform ScaleX="0"/></Rectangle.RenderTransform>
    </Rectangle>
    <TextBlock Canvas.Left="126" Canvas.Top="974" Text="PERSONAL FAN ART" FontFamily="Bahnschrift" FontSize="12" Foreground="#827778"/>
    <TextBlock Canvas.Left="700" Canvas.Top="974" Text="ESC  /  SKIP" FontFamily="Bahnschrift" FontSize="12" Foreground="#998886"/>
  </Canvas>

  <Canvas x:Name="Lockup" Width="1920" Height="1080" Opacity="0">
    <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
    <Viewbox Canvas.Left="130" Canvas.Top="800" Width="51" Height="51">
      <Path x:Name="FinalKnot" Fill="#F6F3ED" Stretch="Uniform"/>
    </Viewbox>
    <TextBlock Canvas.Left="207" Canvas.Top="790" Text="CODEX" FontFamily="Bahnschrift" FontSize="48" Foreground="#F6F3ED"/>
    <TextBlock Canvas.Left="208" Canvas.Top="853" Text="LET'S BUILD." FontFamily="Bahnschrift" FontSize="13" Foreground="#A69A98"/>
  </Canvas>

  <Rectangle x:Name="Flash" Width="1920" Height="1080" Fill="#FFF0DC" Opacity="0"/>
  <Rectangle x:Name="Curtain" Width="1920" Height="1080" Fill="#07080B" Opacity="0"/>
</Canvas>
